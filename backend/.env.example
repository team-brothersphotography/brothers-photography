# SQLite is used by default so the project runs with zero extra setup.
# For real deployment, point this at PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/brothers_photography
DATABASE_URL=sqlite:///./db.sqlite3

SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=5

GOOGLE_CLIENT_ID= your-google-client-id
GOOGLE_CLIENT_SECRET= your-client-secret

DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OWNER_EMAIL=owner@brothersphotography.com
# Only used the very first time the seed script runs, to create the
# initial owner account. Change it immediately after first login via
# the "Change Password" screen in the owner dashboard.
OWNER_DEFAULT_PASSWORD=OwnerPass123
